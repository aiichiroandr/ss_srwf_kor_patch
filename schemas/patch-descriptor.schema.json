{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:srwf-kor:schema:patch-descriptor:v1",
  "title": "Decoded SRWFP v1 patch descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "patchSize",
    "patchSha256",
    "sourceSize",
    "sourceSha256",
    "targetSize",
    "targetSha256",
    "recordCount",
    "bodyUncompressedSize"
  ],
  "properties": {
    "patchSize": {
      "type": "integer",
      "minimum": 101,
      "maximum": 33554432
    },
    "patchSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "targetSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "targetSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "recordCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "bodyUncompressedSize": {
      "type": "integer",
      "minimum": 0,
      "maximum": 67108864
    }
  }
}
